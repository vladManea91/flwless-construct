{% if acasa.cta.titlu %}
<section class="cta">
  <div class="wrap">
    <p class="cota"><span>Următorul pas</span></p>
    <h2>{{ acasa.cta.titlu }}</h2>
    <p>{{ acasa.cta.text }}</p>
    <div class="butoane">
      <a class="btn" href="/contact/">{{ acasa.cta.buton_text or "Contactează-ne" }}</a>
      {% if site.telefon %}
        <a class="btn btn--ghost" href="tel:{{ site.telefon | telLink }}" data-eveniment="telefon-cta">{{ site.telefon }}</a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
