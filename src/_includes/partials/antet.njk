<header class="antet" data-antet>
  <div class="wrap antet__bara">
    <button class="meniu-buton" type="button" data-meniu aria-expanded="false" aria-controls="navigatie-mobil">
      <span class="meniu-buton__linii" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="sr-only">Deschide meniul</span>
    </button>

    <a class="marca" href="/">
      {% if site.logo %}
        <img src="{{ site.logo }}" alt="{{ site.nume }}" width="1024" height="300" fetchpriority="high">
      {% else %}
        <span>{{ site.nume }}</span>
      {% endif %}
      {% if site.tagline %}<span class="marca__tag">{{ site.tagline }}</span>{% endif %}
    </a>

    <nav class="navigatie-desktop" aria-label="Navigare principală">
      <ul>
        {% for element in site.meniu %}
          <li>
            <a href="{{ element.link }}"
               {% if page.url == element.link %}aria-current="page"{% endif %}>{{ element.eticheta }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>

<div class="navigatie-mobil" id="navigatie-mobil" data-navigatie-mobil aria-hidden="true">
  <div class="navigatie-mobil__cap">
    <button class="navigatie-mobil__inchide" type="button" data-meniu-inchide aria-label="Închide meniul">
      <span aria-hidden="true">×</span>
    </button>
  </div>
  <nav aria-label="Navigare principală, meniu mobil">
    <ul>
      {% for element in site.meniu %}
        <li>
          <a href="{{ element.link }}"
             {% if page.url == element.link %}aria-current="page"{% endif %}>{{ element.eticheta }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>
</div>
